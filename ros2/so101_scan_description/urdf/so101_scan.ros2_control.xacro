<?xml version="1.0"?>
<!-- How ros2_control drives the five arm joints: through so101_scan_hardware's STS3215
     driver, or through ros2_control's mock hardware (commands become states instantly)
     for running without the arm. The scan mirror is not here: the ESP32 drives it, and
     scan_mirror_bridge publishes its angle. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="arm_joints" value="${['shoulder_pan', 'shoulder_lift', 'elbow_flex', 'wrist_flex', 'wrist_roll']}"/>

  <xacro:macro name="so101_scan_joint" params="name mock calibration">
    <joint name="${name}">
      <xacro:unless value="${mock}">
        <xacro:property name="c" value="${calibration['joints'][name]}"/>
        <param name="id">${c['id']}</param>
        <param name="zero_ticks">${c['zero_ticks']}</param>
        <param name="sign">${c['sign']}</param>
        <param name="min_ticks">${c['min_ticks']}</param>
        <param name="max_ticks">${c['max_ticks']}</param>
      </xacro:unless>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <xacro:unless value="${mock}">
        <state_interface name="load"/>
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
      </xacro:unless>
    </joint>
  </xacro:macro>

  <xacro:macro name="so101_scan_joints" params="names mock calibration">
    <xacro:if value="${len(names) > 0}">
      <xacro:so101_scan_joint name="${names[0]}" mock="${mock}" calibration="${calibration}"/>
      <xacro:so101_scan_joints names="${names[1:]}" mock="${mock}" calibration="${calibration}"/>
    </xacro:if>
  </xacro:macro>

  <!-- calibration_file: YAML from `ros2 run so101_scan_hardware sts_calibrate`; not needed with mock hardware.
       torque: false switches the motors off and only reads, so the arm can be moved by hand (hold it:
       it goes limp). -->
  <xacro:macro name="so101_scan_ros2_control" params="use_mock_hardware port calibration_file torque">
    <xacro:property name="mock" value="${use_mock_hardware in (True, 'true', 'True', '1')}"/>
    <xacro:if value="${not mock and not calibration_file}">
      ${xacro.fatal('so101_scan: the real arm needs calibration_file:=... (from sts_calibrate); '
                    'or use use_mock_hardware:=true')}
    </xacro:if>
    <xacro:property name="calibration" value="${xacro.load_yaml(calibration_file) if not mock else None}"/>
    <ros2_control name="so101_scan_arm" type="system">
      <hardware>
        <xacro:if value="${mock}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${mock}">
          <plugin>so101_scan_hardware/FeetechStsSystem</plugin>
          <param name="port">${port}</param>
          <param name="baud_rate">1000000</param>
          <param name="timeout_ms">10</param>
          <param name="torque">${'true' if torque in (True, 'true', 'True', '1') else 'false'}</param>
          <!-- false: stopping the launch leaves the servos holding the arm instead of dropping it -->
          <param name="disable_torque_on_deactivate">false</param>
          <!-- the servos' own acceleration limit; 254 is the fastest, as LeRobot sets it -->
          <param name="acceleration">254</param>
          <!-- the driver never moves a joint faster than this, whatever a controller asks -->
          <param name="max_velocity">2.0</param>
          <!-- EEPROM values LeRobot uses for the SO-101, written only when they differ -->
          <param name="return_delay_time">0</param>
          <param name="p_coefficient">16</param>
          <param name="d_coefficient">32</param>
          <param name="i_coefficient">0</param>
          <!-- Safety (so101_scan_hardware/servo_checks.hpp). A limit held for its time stops the arm:
               it holds where it is and ignores the controllers until /arm_safety/reset. -->
          <param name="warn_load">0.6</param>         <!-- fraction of the servo's maximum torque -->
          <param name="max_load">0.9</param>
          <param name="load_time">1.0</param>         <!-- s; a spike while accelerating is shorter -->
          <param name="warn_temperature">55</param>   <!-- deg C; the STS3215 cuts out at 70 on its own -->
          <param name="max_temperature">65</param>
          <param name="temperature_time">1.0</param>
          <!-- V; 0: 80% (warning 90%) of what the supply gives with the arm at rest -->
          <param name="min_voltage">0</param>
          <param name="voltage_time">0.5</param>
          <!-- a joint this far (rad) from its goal and slower than stall_velocity (rad/s) for
               stall_time (s) is stuck: the head on the table, or a caught cable -->
          <param name="stall_error">0.2</param>
          <param name="stall_velocity">0.1</param>
          <param name="stall_time">0.5</param>
          <!-- s: a cause still there this long after the arm started holding switches the motors
               off, since holding isn't helping; 0 never does -->
          <param name="torque_off_after">5.0</param>
          <!-- rad: after a reset, how close a controller's command must be to the arm's pose -->
          <param name="resume_tolerance">0.05</param>
        </xacro:unless>
        <!-- Soft limits: the driver doesn't send a goal past them (so101_scan_hardware/arm_model.hpp),
             and scan_sweep, move_arm and check_plan check plans against the same numbers
             (so101_scan_safety). Mock hardware ignores them, but they are here for the planners. -->
        <param name="soft_limits">true</param>
        <!-- the table top in base_link, and how far above it the arm's links and the head's
             collision box stay (m) -->
        <param name="table_z">-0.0024</param>
        <param name="table_clearance">0.01</param>
        <!-- the head stays out of this cylinder around the shoulder_pan axis: the base, the
             shoulder servo and the electronics beside them (m) -->
        <param name="base_keepout_radius">0.08</param>
        <param name="base_keepout_top">0.14</param>
        <param name="workspace_links">upper_arm_link lower_arm_link wrist_link wrist_roll_link</param>
        <param name="workspace_box_link">scan_head_link</param>
        <!-- gravity torque on any joint, as a fraction of the STS3215's stall torque (16.5 kg cm
             at 6 V; less at 5 V). The arm stretched out level needs 74% at the shoulder
             (cad/README.md, "Arm load"); the scan poses in plans/ need under 50% -->
        <param name="stall_torque">1.62</param>
        <param name="warn_gravity_load">0.5</param>
        <param name="max_gravity_load">0.6</param>
      </hardware>
      <xacro:so101_scan_joints names="${arm_joints}" mock="${mock}" calibration="${calibration}"/>
    </ros2_control>
  </xacro:macro>
</robot>
