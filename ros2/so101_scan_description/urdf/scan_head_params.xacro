<?xml version="1.0"?>
<!-- Generated by scripts/export_head_from_cad.py from cad/so101_hsi_rig.FCStd
     (Params sheet and part placements) and cad/build_report.json. Do not edit by hand:
     change the CAD model, rebuild it, and run the script again.
     Head frame: origin on the wrist-roll horn face, +Z away from the wrist,
     +Y toward the scene (scan window), X along the slit and the mirror shaft.
     Lengths in metres, angles in radians. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- head origin: wrist-roll horn face, 3 mm along the roll axis from wrist_roll_link (horn_z) -->
  <xacro:property name="head_mount_z" value="-0.003"/>
  <!-- scan mirror shaft axis (along X), Y (y_shaft) -->
  <xacro:property name="mirror_shaft_y" value="-0.0023"/>
  <!-- scan mirror shaft axis, Z (z_shaft) -->
  <xacro:property name="mirror_shaft_z" value="0.0241"/>
  <!-- mirror angle at rest: its face turned 45 deg about X, 45 deg to the optical axis -->
  <xacro:property name="mirror_rest" value="0.785398"/>
  <!-- mirror front surface to the shaft axis (mirror_e) -->
  <xacro:property name="mirror_face_offset" value="0.0071"/>
  <!-- mirror angle where the hall sensor sees the magnet (mirror_home, -40 deg) -->
  <xacro:property name="mirror_home" value="-0.698132"/>
  <!-- mirror turn either side of rest for a full scan (the view turns twice as far: scan_half = 12 deg) -->
  <xacro:property name="mirror_scan_half" value="0.10472"/>
  <!-- optical axis Y (y_axis) -->
  <xacro:property name="objective_y" value="0.00272"/>
  <!-- objective principal plane Z (z_obj) -->
  <xacro:property name="objective_z" value="0.05012"/>
  <!-- objective to the in-focus scan line, along the folded axis (scene_dist) -->
  <xacro:property name="scene_distance" value="0.15"/>
  <!-- half length of the scan line on the scene (half_line) -->
  <xacro:property name="scan_line_half_length" value="0.020937"/>
  <!-- objective focal length (f_obj) -->
  <xacro:property name="objective_focal_length" value="0.016"/>
  <!-- slit length (slit_len) -->
  <xacro:property name="slit_length" value="0.005"/>
  <!-- Pi NoIR v2 pose camera board, lens centre on the PCB back -->
  <xacro:property name="pose_camera_x" value="0"/>
  <xacro:property name="pose_camera_y" value="0.02172"/>
  <xacro:property name="pose_camera_z" value="0.05112"/>
  <!-- board frame: +Z out of the lens, +Y toward the wrist -->
  <xacro:property name="pose_camera_roll" value="-1.570796"/>
  <!-- PCB back to the front of the lens module (RPI-CAM-V2 drawing) -->
  <xacro:property name="pose_camera_lens" value="0.0045"/>
  <!-- mass budget in cad/build_report.json, wrist puck included -->
  <xacro:property name="head_mass" value="0.1882"/>
  <!-- centre of mass in the head frame (build_report.json) -->
  <xacro:property name="head_com_x" value="-0.0106"/>
  <xacro:property name="head_com_y" value="-0.0011"/>
  <xacro:property name="head_com_z" value="0.0555"/>
  <!-- inertia of a solid box the head's size (66 x 53 x 135 mm) about the centre of mass -->
  <xacro:property name="head_ixx" value="0.000331"/>
  <xacro:property name="head_iyy" value="0.000355"/>
  <xacro:property name="head_izz" value="0.000113"/>
</robot>
