# Stable names for the two USB serial devices, so launch files don't depend on which one
# got /dev/ttyACM0:
#   /dev/so101         the SO-101's servo bus adapter
#   /dev/scan_mirror   the scan-mirror ESP32
#
# Install on the host (the Jetson), not in the container:
#   sudo cp ros2/udev/99-so101-scan.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# The vendor:product ids below are the common ones; check yours with `lsusb` while plugging
# each device in, and fix the lines to match. If both devices use the same chip (a CH340 ESP32
# board and a CH340 servo adapter, say), add ATTRS{serial}=="..." from
#   udevadm info -a -n /dev/ttyACM0 | grep -m1 'ATTRS{serial}'
# to tell them apart (CH340 has no serial number: then use the USB port instead, KERNELS=="1-2.1").

# Servo bus: Waveshare bus servo adapter (CH343, 1a86:55d3), shipped with the SO-101 kits
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", SYMLINK+="so101", MODE="0666"
# Servo bus: Feetech FE-URT-1 (CH340, 1a86:7523); uncomment if that's the adapter
#SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="so101", MODE="0666"

# Scan mirror: ESP32 DevKit with a CP2102 (10c4:ea60)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="scan_mirror", MODE="0666"
# Scan mirror: ESP32-S3 or C3 on its own USB port (303a:1001); uncomment if that's the board
#SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", SYMLINK+="scan_mirror", MODE="0666"
