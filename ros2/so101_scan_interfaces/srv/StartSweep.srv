# Step the scan mirror through n_lines lines, holding still on each for about a camera frame,
# and publish a ScanLine on /scan_mirror/line for each. Returns as soon as the ESP32 accepts the
# sweep. The ScanLine with last = true marks the end; a sweep cut short (~/stop, a driver fault)
# shows up as MirrorState with this sweep_id and busy = false.
float64 start_angle    # rad, same convention as ScanLine.angle; rounded to a whole microstep
int32 steps_per_line   # microsteps between lines; the sign sets the direction
uint32 n_lines
float64 line_period    # s from one line to the next, at least 0.001
---
bool accepted
string message         # why not, when rejected (not homed, busy, out of range)
uint32 sweep_id
float64 start_angle    # the angle actually used, after rounding
float64 rad_per_step   # mirror rad per microstep
