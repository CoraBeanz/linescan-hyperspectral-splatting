	(text "J5 to the Jetson's 40-pin header (3.3 V GPIO): MOVING, TRIG, GND. R5 and R6 protect both ends from a wrong pin."
		(exclude_from_sim no)
		(at 25.4 266.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "03ce8c27-088a-5e84-bb60-9cf27fdaa271")
	)
	(text "JP1 picks the module pin: 1-2 = pin 4 (BTT default), 2-3 = pin 5."
		(exclude_from_sim no)
		(at 175.26 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "227e0e7d-b045-5d60-969a-dcbf0a4038cb")
	)
	(text "12 V in on J1 or J2 (ALITOVE 12 V 3 A). F1 limits it, D1 blocks reverse polarity, D2 clamps spikes under the TMC2209's 29 V limit. D3 is lit while the motor has power."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "38db838b-72cb-5ead-8429-2aeade028f86")
	)
	(text "The ESP32 is powered over USB from the Jetson, which is also its command link, so there is no 5 V regulator here."
		(exclude_from_sim no)
		(at 25.4 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "419e54ee-eeaa-5a6f-a519-e6cc7e5f0535")
	)
	(text "With USB unplugged the TMC2209 has no logic supply (VDD), so the motor cannot move."
		(exclude_from_sim no)
		(at 25.4 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4295d926-fdf3-5dd5-afb6-2e4db13450b3")
	)
	(text "BEFORE FIRST POWER-UP: with the motor unplugged, turn VREF to 0.28 V (0.2 A)."
		(exclude_from_sim no)
		(at 175.26 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4f88eb9a-f15f-5a0e-90bc-74be25e6b2cb")
	)
	(text "MS1 = MS2 = GND: UART address 0. CLK = GND: internal clock."
		(exclude_from_sim no)
		(at 175.26 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "54c12a65-590d-5069-ae93-d1322353fac6")
	)
	(text "Never plug or unplug the motor with 12 V on."
		(exclude_from_sim no)
		(at 175.26 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "79275981-23ba-5c94-a8dc-0c5b38bf322f")
	)
	(text "Scan-mirror controller: ESP32-DevKitC + BTT TMC2209 for the NEMA 8 mirror stepper"
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a773df89-4ead-5a89-babe-7fabe85fc47c")
	)
	(text "UART: RX (IO16) straight to PDN_UART, TX (IO17) through R3."
		(exclude_from_sim no)
		(at 175.26 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "aff48e03-6d53-5e3c-8634-208e615281d3")
	)
	(text "R4 limits current into IO33 if the cable is miswired. C3 is fitted only if motor noise shows up."
		(exclude_from_sim no)
		(at 271.78 242.57 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ccb82abb-1db5-55ef-8aff-3d54a0751f61")
	)
	(text "Hall: A3144 runs on 5 V; its open-collector OUT is pulled up to 3.3 V by R2."
		(exclude_from_sim no)
		(at 271.78 238.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d2ae943b-4621-5ee2-8f4e-7384c40cdd65")
	)
	(text "R1 holds EN high (motor off) while the ESP32 boots."
		(exclude_from_sim no)
		(at 175.26 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "eecde533-acbd-5056-a5a9-63a9c239cea1")
	)
